# Required: Anthropic credentials (read at container start).
# Either use an API key:
ANTHROPIC_API_KEY=
# ...or a gateway / proxy that expects a bearer token plus a base URL:
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_BASE_URL=

# Optional: protect the HTTP API with a bearer token. Health endpoints stay open.
# SERVICE_API_KEY=

# Optional tuning
# CLAUDE_MODEL=
# CLAUDE_PERMISSION_MODE=bypassPermissions
# CLAUDE_INCLUDE_PARTIAL_MESSAGES=true
# CLAUDE_BARE=false
# CLAUDE_BIN=/usr/local/bin/claude
# CLAUDE_HOME=/home/agent
# MAX_CONCURRENT_TASKS=2
# MAX_QUEUE_SIZE=32
# TASK_TIMEOUT_MS=600000
# MAX_TASK_TIMEOUT_MS=3600000
# MAX_EVENTS_PER_TASK=5000
# TASK_TTL_MS=0
# LOG_LEVEL=info
# PORT=8080
# AGENT_API_PORT=8080
# WORKSPACE_HOST_DIR=./workspace
# STATE_DIR_HOST=./state
# STATE_DIR=/var/lib/agent-api
